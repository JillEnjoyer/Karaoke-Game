; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VocaLume"
config/description="A game, where is possible to create, edit, play and capture musical composition.
Different languages?
Lots of subtitles?
Wish to maintain a whole Karaoke bar with one video broadcaster through the room with internet? 
- It is it"
config/version="0.3.37"
run/main_scene="uid://c76nh51iw8yh3"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

ViewportBase="*res://Components/CORE/ViewportBase/ViewportBase.tscn"
BaseScene="*res://Components/CORE/ViewportBase/BaseScene.tscn"
PreferencesData="*res://Components/CORE/Preferences/PreferencesData.gd"
UIManager="*res://Components/CORE/Preloader/ui_manager.gd"
Debugger="*res://Components/CORE/Debug/Debugger.gd"
TextureLoader="*res://Components/CORE/Preloader/texture_loader.gd"
VocatoolWatchdog="*res://Components/CORE/VocaTool/vocatool_watchdog.gd"
SignalBus="*res://Components/CORE/SignalBus/signal_bus.gd"
GlobalEnums="*res://Components/CORE/Enums/enums.gd"
NetworkManager="*res://Components/CORE/NetworkManager/network_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[dotnet]

project/assembly_name="Karaoke Game"

